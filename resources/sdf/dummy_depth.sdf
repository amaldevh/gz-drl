<sdf version="1.9">
<model name="dummy_warmup_model">
  <static>true</static>
  <pose>0 0 -100 0 0 0</pose> {/* Placed far underground so it sees nothing */}
  <link name="dummy_link">
    <sensor name="dummy_depth_camera" type="depth_camera">
      <always_on>1</always_on>
      <update_rate>1</update_rate> {/* 1 Hz to minimize CPU load */}
      <camera>
        <horizontal_fov>1.05</horizontal_fov>
        <image>
          <width>8</width> {/* Extremely low resolution */}
          <height>8</height>
          <format>R_FLOAT32</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
    </sensor>
  </link>
</model>
</sdf>