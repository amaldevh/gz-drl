<sdf version="1.9">
  <world name="world_demo">
    <physics type="dart">
    <!--4ms step-->
      <max_step_size>0.001</max_step_size>
      <real_time_factor>0</real_time_factor>
      <real_time_update_rate>5000000</real_time_update_rate>
      <dart>
        <solver><solver_type>dantzig</solver_type></solver>
        <collision_detector>bullet</collision_detector>
      </dart>
    </physics>

    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system">
        <engine>
          <filename>gz-physics-dartsim-plugin</filename>
        </engine>
    </plugin>
    <!-- <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system" />
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system" />
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/> -->
    <!-- <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin> -->
    <model name="ground_plane">
    <pose>0 0 0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>



    <gravity>0 0 -9.82</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic" />
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.8 1</background>
      <shadows>false</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 10 0 -0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

     <light name="lights1" type="directional">
      <pose>0 0 3 0 -0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>0 0 -1</direction>
    </light>
    <light name="lights2" type="directional">
      <pose>1 0 3 0 -0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>0 0 -1</direction>
    </light>

    <light name="lights3" type="directional">
      <pose>-1 0 3 0 -0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>0 0 -1</direction>
    </light>

    <light name="lights4" type="directional">
      <pose>0 1 3 0 -0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>0 0 -1</direction>
    </light>

    <light name="lights5" type="directional">
      <pose>0 1 3 0 -0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>0 0 -1</direction>
    </light>

  
     <include>
        <uri>model://hinge_hoop_gate.sdf</uri>
        <name>dynamic_hoop</name>
        <pose>-2.0 7.0 1.5 0 0 10.206990816987242</pose>
    </include>
  
    <include>
        <uri>model://quadrotor.sdf</uri>
        <name>quadrotor</name>
        <pose>0 0.0 0.15 0 0 0</pose>
    </include>
    <include>
        <uri>model://ackermann_car/car.sdf</uri>
        <name>car</name>
        <pose>-5.0 -5.0 0.15 0 0 0</pose>
    </include>
    
  </world>
</sdf>