            </mesh>
          </geometry>
          <!-- <material>
            <ambient>0.300000012 0.300000012 0.300000012 1</ambient>
            <diffuse>0.699999988 0.699999988 0.699999988 1</diffuse>
            <specular>1 1 1 1</specular>
          </material> -->
        </visual>
        <!-- <pose>0 0 0 1.57 0 0</pose> -->
        <enable_wind>false</enable_wind>
      </link>

    <!--Joint 12-->
    <joint name='12joint' type='fixed'>
      <parent>link1</parent>
      <child>link2</child>
      <pose>0 0 {{ gate_width/2 }} 0 0 0</pose>
    </joint>
    
    <!--Joint 23-->
    <joint name='23joint' type='fixed'>
      <pose>0 -{{ gate_width/2 }} 0 0 0 0</pose>
      <parent>link2</parent>
      <child>link3</child>
    </joint>

    <!--Joint 34-->
    <joint name='34joint' type='fixed'>
      <pose>0 0 -{{ gate_width/2 }} 0 0 0</pose>
      <parent>link3</parent>
      <child>link4</child>
    </joint>

    

      <static>true</static>
      <self_collide>false</self_collide>
    </model>

</sdf>