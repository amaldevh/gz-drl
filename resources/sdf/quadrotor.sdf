    <plugin name='gz::sim::systems::MultiRotorPlugin' filename='rotor_plugin'>
      <parentLink>quadrotor/base_link</parentLink>
      <linkNames>quadrotor/rotor_0 quadrotor/rotor_1 quadrotor/rotor_2 quadrotor/rotor_3</linkNames>
      <turningDirections>1 -1 -1 1</turningDirections>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>2246.0</maxRotVelocity>
      <thrustConstantQuadraticParams>1.9533e-6 0 0</thrustConstantQuadraticParams>
      
      <groundEffectConstant>1.17198e-09</groundEffectConstant>
      <momentConstantQuadraticParams>2.8400982e-08  0 0</momentConstantQuadraticParams>
      <downWashCoefficients>0.0 0.0 0.0</downWashCoefficients>
      <otherUavNames></otherUavNames>
      <rotorInertia>4.92e-6</rotorInertia>
      <rotorDragCoefficient>0.000020673</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-9</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>2</rotorVelocitySlowdownSim>
    </plugin>

   
    <!-- <plugin name='gz::sim::systems::Imu' filename='gz-sim-imu-system'/> -->
    <frame name='cam_joint' attached_to='quadrotor/base_link'>
      <pose>0 0 0 0 0 0</pose>
    </frame>
    <frame name='cam_link' attached_to='cam_joint'>
      <pose>0 0 0 0 0 0</pose>
    </frame>
    <frame name='imu_joint' attached_to='quadrotor/base_link'>
      <pose>0 0 0 0 0 0</pose>
    </frame>
    <frame name='imu_link' attached_to='imu_joint'>
      <pose>0 0 0 0 0 0</pose>
    </frame>
    <frame name='quadrotor/base_joint' attached_to='quadrotor/base_link'>
      <pose>0 0 0 0 0 0</pose>
    </frame>
    <frame name='quadrotor/base_link_inertia' attached_to='quadrotor/base_joint'>
      <pose>0 0 0 0 0 0</pose>
    </frame>
  </model>
</sdf>
