    </link>

    

    <joint name='quadrotor/rotor_0_joint' type='revolute'>
      <pose relative_to='quadrotor/base_link'>-0.1016 -0.127 0.023 0 0 0</pose>
      <parent>quadrotor/base_link</parent>
      <child>quadrotor/rotor_0</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-inf</lower>
          <upper>inf</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='quadrotor/rotor_0'>
      <pose relative_to='quadrotor/rotor_0_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.0050000000000000001</mass>
        <inertia>
          <ixx>1.9500000000000001e-07</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>3.3340833333333338e-05</iyy>
          <iyz>0</iyz>
          <izz>3.3520833333333339e-05</izz>
        </inertia>
      </inertial>
      <collision name='quadrotor/rotor_0_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.0050000000000000001</length>
            <radius>0.10000000000000001</radius>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <visual name='quadrotor/rotor_0_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://meshes/motor_prop_assembly.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0 0 1 1</ambient>
          <diffuse>0 0 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <emissive>0 0 0 0</emissive>
      </material>
      </visual>
    </link>
    <joint name='quadrotor/rotor_1_joint' type='revolute'>
      <pose relative_to='quadrotor/base_link'>0.1016 -0.127 0.023 0 0 0</pose>
      <parent>quadrotor/base_link</parent>
      <child>quadrotor/rotor_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-inf</lower>
          <upper>inf</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='quadrotor/rotor_1'>
      <pose relative_to='quadrotor/rotor_1_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.0050000000000000001</mass>
        <inertia>
          <ixx>1.9500000000000001e-07</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>3.3340833333333338e-05</iyy>
          <iyz>0</iyz>
          <izz>3.3520833333333339e-05</izz>
        </inertia>
      </inertial>
      <collision name='quadrotor/rotor_1_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.0050000000000000001</length>
            <radius>0.10000000000000001</radius>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <visual name='quadrotor/rotor_1_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://meshes/motor_prop_assembly.dae</uri>
