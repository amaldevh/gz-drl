<sdf version='1.11'>
  <model name='quadrotor'>
   
    
    <enable_wind>1</enable_wind>
    <link name='quadrotor/base_link'>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>1.52</mass>
        <inertia>
          <ixx>14387108.65e-9</ixx>
          <iyy>16559882.52e-9</iyy>
          <izz>28784890.45e-9</izz>
        </inertia>
      </inertial>
      <collision name='quadrotor/base_link_inertia_collision_2'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.2 0.2 0.05</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <collide_without_contact>1</collide_without_contact>
          </contact>
        </surface>
      </collision>
      <!-- <sensor name='sensor_contact' type='contact'>
          <contact>
            <collision>quadrotor/base_link_inertia_collision_2</collision>
            <topic>/base_link_contact</topic>
          </contact>
          <always_on>1</always_on>
          <update_rate>100</update_rate>
        </sensor> -->
      <visual name='quadrotor/base_link_inertia_visual_2'>
        <pose>0 0 0 3.1415920000000002 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://meshes/QDrone2_Combined.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <sensor name='grayscale' type='camera'>
        <camera name='graycale'>
          <image>
            <width>640</width>
            <height>480</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.10000000000000001</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>1e-3</stddev>
          </noise>
       
          <lens>
            <type>stereographic</type>
            <scale_to_hfov>1</scale_to_hfov>

              <intrinsics>
       
              <fx>381.47</fx> 
              <fy>762.156</fy> 
              <cx>297.96</cx> 
              <cy>215.755</cy>
             
            </intrinsics>
            <projection>
              <p_fx>381.47</p_fx> 
              <p_fy>762.156</p_fy>
              <p_cx>297.96</p_cx> 
              <p_cy>215.755</p_cy>


            </projection>
          </lens>
        </camera>
        <always_on>false</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <pose>0.125 0 -0.0375 3.14 1.57 3.14</pose>
      </sensor>
      <!--rgbd-->
       <sensor name='rgb' type='camera'>
        <camera name='rgb'>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.10000000000000001</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>1e-3</stddev>
          </noise>
    
          <lens>
            <type>stereographic</type>
            <scale_to_hfov>1</scale_to_hfov>

              <intrinsics>
        
              <fx>381.47</fx> 
              <fy>762.156</fy> >
              <cx>297.96</cx> 
              <cy>215.755</cy>
          
            </intrinsics>
            <projection>
              <p_fx>381.47</p_fx> 
              <p_fy>762.156</p_fy>
              <p_cx>297.96</p_cx> 
              <p_cy>215.755</p_cy>
              
            </projection>
          </lens>
        </camera>
        <always_on>false</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <pose>0.15 0 0 0 0 0</pose>
      </sensor>
       <sensor name='depth' type='depth_camera'>
        <camera name='depth_cam'>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.10000000000000001</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>1e-3</stddev>
          </noise> 
        </camera> 
        <always_on>false</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <pose>0.2 0 0 0 0 0</pose>
      </sensor>

