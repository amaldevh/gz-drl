        <pose>0 0 0 0 0 0</pose>
        <mass>1.52</mass>
        <inertia>
          <ixx>14387108.65e-9</ixx>
          <iyy>16559882.52e-9</iyy>
          <izz>28784890.45e-9</izz>
        </inertia>
      </inertial>
      <collision name="quadrotor1/base_link_inertia_collision_2">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.2 0.2 0.05</size></box></geometry>
        <surface><contact><collide_without_contact>1</collide_without_contact></contact></surface>
      </collision>
