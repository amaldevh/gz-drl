      <otherUavNames></otherUavNames><rotorInertia>4.92e-6</rotorInertia><actuator_number>3</actuator_number><rotorDragCoefficient>0.000020673</rotorDragCoefficient><rollingMomentCoefficient>1e-9</rollingMomentCoefficient><rotorVelocitySlowdownSim>2</rotorVelocitySlowdownSim></plugin> -->
  <plugin name='gz::sim::systems::MultiRotorPlugin' filename='rotor_plugin'>
      <parentLink>quadrotor4/base_link</parentLink>
      <linkNames>quadrotor4/rotor_0 quadrotor4/rotor_1 quadrotor4/rotor_2 quadrotor4/rotor_3</linkNames>
      <turningDirections>1 -1 -1 1</turningDirections>
      <timeConstantUp>0.0005</timeConstantUp>
      <timeConstantDown>0.005</timeConstantDown>
      <maxRotVelocity>2340.0</maxRotVelocity>
      <thrustConstantQuadraticParams>1.9533e-6 0 0</thrustConstantQuadraticParams>
      
      <groundEffectConstant>1.17198e-09</groundEffectConstant>
      <momentConstantQuadraticParams>2.8400982e-08  0 0</momentConstantQuadraticParams>
      <downWashCoefficients>0.0 0.0 0.0</downWashCoefficients>
      <otherUavNames></otherUavNames>
      <rotorInertia>4.92e-6</rotorInertia>
      <rotorDragCoefficient>0.000020673</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-9</rollingMomentCoefficient>
      
      <rotorVelocitySlowdownSim>2</rotorVelocitySlowdownSim>
      
    </plugin>
    <!-- =========================
         PAYLOAD (links only; origin frame below)
         ========================= -->
    <frame name="payload_base" attached_to="__model__">
      <!-- was <model pose> in your nested payload model -->
      <pose>0 0 0.0 0 0 0</pose>
    </frame>

    <link name="payload_box_link">
      <pose relative_to="payload_base">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.04427</ixx><iyy>0.04427</iyy><izz>0.083</izz></inertia>
      </inertial>
      <collision name="payload_col"><geometry><box><size>1.0 1.0 0.25</size></box></geometry></collision>
      <visual name="payload_vis"><geometry><box><size>1.0 1.0 0.25</size></box></geometry></visual>
    </link>

    <link name="corner1">
      <pose relative_to="payload_base">0.5 0.5 0.125 0 0 0</pose>
      <inertial><mass>0.001</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia></inertial>
      <visual name="vis_corner1"><geometry><sphere><radius>0.02</radius></sphere></geometry><material><ambient>1 0 0 1</ambient></material></visual>
    </link>
    <link name="corner2">
      <pose relative_to="payload_base">-0.5 0.5 0.125 0 0 0</pose>
      <inertial><mass>0.001</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia></inertial>
      <visual name="vis_corner2"><geometry><sphere><radius>0.02</radius></sphere></geometry><material><ambient>0 1 0 1</ambient></material></visual>
    </link>
    <link name="corner3">
      <pose relative_to="payload_base">-0.5 -0.5 0.125 0 0 0</pose>
      <inertial><mass>0.001</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia></inertial>
      <visual name="vis_corner3"><geometry><sphere><radius>0.02</radius></sphere></geometry><material><ambient>0 0 1 1</ambient></material></visual>
    </link>
    <link name="corner4">
      <pose relative_to="payload_base">0.5 -0.5 0.125 0 0 0</pose>
      <inertial><mass>0.001</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia></inertial>
      <visual name="vis_corner4"><geometry><sphere><radius>0.02</radius></sphere></geometry><material><ambient>1 1 0 1</ambient></material></visual>
   
    </link>
<joint name="corner1_to_payload" type="fixed">
      <parent>payload_box_link</parent>
      <child>corner1</child>
    </joint>
    <joint name="corner2_to_payload" type="fixed">
      <parent>payload_box_link</parent>
      <child>corner2</child>
    </joint>
    <joint name="corner3_to_payload" type="fixed">
      <parent>payload_box_link</parent>
      <child>corner3</child>
    </joint>
    <joint name="corner4_to_payload" type="fixed">
      <parent>payload_box_link</parent>
      <child>corner4</child>
    </joint>
    <!-- =========================
         TETHERS (as links)
         ========================= -->
    <link name="tether1_link">
      <pose>0.5  0.5  0.625  0  0  0</pose>
      <inertial><mass>0.006</mass><inertia><ixx>5e-4</ixx><iyy>5e-4</iyy><izz>1.20e-8</izz></inertia></inertial>
      <collision name="tether1_col">
        <geometry><cylinder><radius>0.002</radius><length>1</length></cylinder></geometry>
        <surface><contact><collide_bitmask>0x00</collide_bitmask></contact></surface>
      </collision>
      <visual name="tether1_vis">
        <geometry><cylinder><radius>0.002</radius><length>1</length></cylinder></geometry>
      </visual>
    </link>

    <link name="tether2_link">
      <pose>-0.5  0.5  0.625  0  0  0</pose>
      <inertial><mass>0.006</mass><inertia><ixx>5e-4</ixx><iyy>5e-4</iyy><izz>1.20e-8</izz></inertia></inertial>
      <collision name="tether2_col"><geometry><cylinder><radius>0.002</radius><length>1</length></cylinder></geometry><surface><contact><collide_bitmask>0x00</collide_bitmask></contact></surface></collision>
      <visual name="tether2_vis"><geometry><cylinder><radius>0.002</radius><length>1</length></cylinder></geometry></visual>
    </link>

    <link name="tether3_link">
      <pose>-0.5  -0.5  0.625  0  0  0</pose>
      <inertial><mass>0.006</mass><inertia><ixx>5e-4</ixx><iyy>5e-4</iyy><izz>1.20e-8</izz></inertia></inertial>
      <collision name="tether3_col"><geometry><cylinder><radius>0.002</radius><length>1</length></cylinder></geometry><surface><contact><collide_bitmask>0x00</collide_bitmask></contact></surface></collision>
      <visual name="tether3_vis"><geometry><cylinder><radius>0.002</radius><length>1</length></cylinder></geometry></visual>
    </link>

    <link name="tether4_link">
      <pose>0.5  -0.5  0.625  0  0  0</pose>
      <inertial><mass>0.006</mass><inertia><ixx>5e-4</ixx><iyy>5e-4</iyy><izz>1.20e-8</izz></inertia></inertial>
      <collision name="tether4_col"><geometry><cylinder><radius>0.002</radius><length>1</length></cylinder></geometry><surface><contact><collide_bitmask>0x00</collide_bitmask></contact></surface></collision>
      <visual name="tether4_vis"><geometry><cylinder><radius>0.002</radius><length>1</length></cylinder></geometry></visual>
    </link>

    <!-- =========================
         BALL JOINTS (top/bottom per tether)
         ========================= -->
    <!-- Tether 1 -->
    <joint name="t1_top" type="ball">
      <child>quadrotor1/base_link</child>
      <parent>tether1_link</parent>
      <pose relative_to="tether1_link">0 0 0.5 0 0 0</pose>
    </joint>
    <joint name="t1_bottom" type="fixed">
      <child>tether1_link</child>
      <parent>corner1</parent>
      <pose relative_to="tether1_link">0 0 -0.5 0 0 0</pose>
    </joint>

    <!-- Tether 2 -->
    <joint name="t2_top" type="ball">
      <child>quadrotor2/base_link</child>
      <parent>tether2_link</parent>
      <pose relative_to="tether2_link">0 0 0.5 0 0 0</pose>
    </joint>
    <joint name="t2_bottom" type="fixed">
      <child>tether2_link</child>
