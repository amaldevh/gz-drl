      <downWashCoefficients>0.0 0.0 0.0</downWashCoefficients>
      <otherUavNames></otherUavNames><rotorInertia>4.92e-6</rotorInertia><actuator_number>2</actuator_number><rotorDragCoefficient>0.000020673</rotorDragCoefficient><rollingMomentCoefficient>1e-9</rollingMomentCoefficient><rotorVelocitySlowdownSim>2</rotorVelocitySlowdownSim></plugin>
