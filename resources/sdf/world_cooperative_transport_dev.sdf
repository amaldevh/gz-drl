        <pose>0 0 0 3.1415920000000002 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <!-- NOTE: ensure meshes are available under this model or fix URI -->
            <uri>model://meshes/QDrone2_Combined.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

