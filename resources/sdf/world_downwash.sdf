        </visual>
      </link>
    </model>  -->



    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic" />
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.8 1</background>
      <shadows>true</shadows>
      <sky>
      <sunrise>10</sunrise>
      </sky>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 10 0 -0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
    <visualize>false</visualize>
    </light>

     <light name="lights1" type="directional">
      <pose>0 0 3 0 -0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>0 0 -1</direction>
    <visualize>false</visualize>
    </light>
    <light name="lights2" type="directional">
      <pose>1 0 3 0 -0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>0 0 -1</direction>
    <visualize>false</visualize>
    </light>

    <light name="lights3" type="directional">
      <pose>-1 0 3 0 -0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>0 0 -1</direction>
    <visualize>false</visualize>
    </light>

    <light name="lights4" type="directional">
      <pose>0 1 3 0 -0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>0 0 -1</direction>
    <visualize>false</visualize>
    </light>

    <light name="lights5" type="directional">
      <pose>0 1 3 0 -0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>0 0 -1</direction>
    <visualize>false</visualize>
    </light>

 
 <include>
        <uri>model://quadrotor_with_downwash.sdf</uri>
        <name>quadrotor1</name>
        <pose>0 0. 0.15 0 0 0</pose>
    </include>
    <include>
        <uri>model://quadrotor_with_downwash.sdf</uri>
        <name>quadrotor2</name>
        <pose>0 1. 0.15 0 0 0</pose>
    </include>

   <!-- <include>
        <uri>model://crazyflie.sdf</uri>
        <name>crazyflie</name>
        <pose>0 0. 0.15 0 0 0</pose>
    </include> -->
  </world>
</sdf>